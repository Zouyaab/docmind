# DocMind environment variables
# Copy to `.env` for local development. Do not commit real secrets.

# --- API binding ---
API_HOST=127.0.0.1
API_PORT=3000
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info

# Optional Bearer auth for non-public routes. Leave empty for local/dev.
API_TOKEN=

# --- Persistence ---
# Unset = in-memory stores (default for tests/CI).
# Set to enable PostgreSQL + pgvector persistence.
# DATABASE_URL=postgres://docmind:docmind@127.0.0.1:5432/docmind
EMBEDDING_DIMENSIONS=32

# --- AI providers ---
# mock (default, offline) | ollama (local inference)
AI_PROVIDER=mock
EMBEDDING_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_MS=30000
OLLAMA_RETRIES=1

# --- RAG ---
RAG_MIN_SCORE=0

# Vite dashboard (apps/web)
# VITE_API_URL=http://127.0.0.1:3000
