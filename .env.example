# DocMind environment variables
# Copy to `.env` for local development. Do not commit real secrets.

# --- Required for binding the API (defaults applied if unset) ---

# Bind address for the HTTP server.
# Use 0.0.0.0 inside Docker so the container accepts external connections.
API_HOST=127.0.0.1

# TCP port for the HTTP API.
API_PORT=3000

# Maximum upload size in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760

# Pino/Fastify log level: debug | info | warn | error
LOG_LEVEL=info

# --- Optional security ---

# When set to a non-empty value, all API routes except health/version/OpenAPI
# require: Authorization: Bearer <token>
# Leave empty for local development without auth.
# Security: treat this as a secret; never commit real tokens.
API_TOKEN=

# --- Optional AI (Ollama) ---
# Used only when switching providers from Mock to Ollama.
# Default tests and CI stay offline with Mock providers.

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# --- Optional persistence (not required by MVP API) ---
# Reserved for future Postgres/pgvector integration.
# DATABASE_URL=postgres://docmind:docmind@127.0.0.1:5432/docmind

# Vite dashboard API origin (apps/web only)
# VITE_API_URL=http://127.0.0.1:3000
