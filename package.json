{
  "name": "docmind",
  "version": "0.2.0",
  "private": true,
  "description": "Local-first AI Document Intelligence & Decision Engine — TypeScript application/backend monorepo (API, CLI, SDK, RAG, decision engine)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "keywords": [
    "document-intelligence",
    "rag",
    "typescript",
    "monorepo",
    "fastify",
    "decision-engine",
    "local-first",
    "application",
    "backend"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Zouyaab/docmind.git"
  },
  "homepage": "https://github.com/Zouyaab/docmind",
  "bugs": {
    "url": "https://github.com/Zouyaab/docmind/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "evaluate": "pnpm --filter @docmind/evaluation start",
    "benchmark": "pnpm --filter @docmind/evaluation benchmark",
    "dev": "pnpm --filter @docmind/api dev",
    "dev:web": "pnpm --filter @docmind/web dev",
    "cli": "pnpm --filter @docmind/cli start",
    "audit:prod": "pnpm audit --prod --audit-level=high"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.1.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
